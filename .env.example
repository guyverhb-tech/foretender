# Copy to .env.local and fill in. Never commit the filled-in copy.
# Every variable the code reads should appear here, even without a value —
# this file is what makes a missing key visible before it's a runtime error.

# Anthropic Messages API key, read ONLY by src/cli/live-model.ts (the model
# predictor's live shell). Required solely for the opt-in `--live` path of
# `node dist/cli/model-predict.js`; the default replay path and every test run
# with no key and make no network calls. Set only as the `x-api-key` header —
# it is never written to the model-call ledger.
ANTHROPIC_API_KEY=
